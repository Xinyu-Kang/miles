+    def restore_weights_before_loading(self, layer: Module) -> None:
+        if not (_use_aiter_moe() and self.is_fp4_expert):
+            return
+
+        def replace_parameter(name: str, data: torch.Tensor) -> None:
+            old_param = getattr(layer, name)
+            new_param = torch.nn.Parameter(data, requires_grad=False)
+            for attr, value in getattr(old_param, "__dict__", {}).items():
+                setattr(new_param, attr, value)
+            if hasattr(new_param, "is_shuffled"):
+                new_param.is_shuffled = False
+            setattr(layer, name, new_param)
+
+        device = layer.w13_weight.device
+        num_experts = layer.num_local_experts
+        hidden_size = layer.hidden_size
+        intermediate_size = layer.intermediate_size_per_partition
+        fp4_block_k = 32
+
+        replace_parameter(
+            "w13_weight",
+            torch.empty(
+                num_experts,
+                2 * intermediate_size,
+                hidden_size // 2,
+                dtype=torch.int8,
+                device=device,
+            ),
+        )
+        replace_parameter(
